  - m_Id: 4464429511991296
    m_Localized: 'INICIO

'
    m_Metadata:
      m_Items: []
  - m_Id: 4464440865972224
    m_Localized: CONTROLES
    m_Metadata:
      m_Items: []
  - m_Id: 4464445630701568
    m_Localized: AJUSTES
    m_Metadata:
      m_Items: []
  - m_Id: 4464448629628928
    m_Localized: "CR\xC9DITOS"
    m_Metadata:
      m_Items: []
  - m_Id: 4464451574030336
    m_Localized: AL ESCRITORIO
    m_Metadata:
      m_Items: []
  - m_Id: 4464461040574464
    m_Localized: "Solo hay dos controles:\r\n\r\nPulsa \xABA\xBB para mover la nave
      hacia la izquierda,\r\nPulsa \xABD\xBB para mover la nave hacia la derecha.\r\n\r\nSe
      puede acceder a todos los botones del men\xFA haciendo clic con el rat\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 4473027256377344
    m_Localized: ENGLISH
    m_Metadata:
      m_Items: []
  - m_Id: 4473043366699008
    m_Localized: "ESPA\xD1OL"
    m_Metadata:
      m_Items: []
  - m_Id: 4474607493963776
    m_Localized: 'Artista de interfaz de usuario:

      Alexandra Sharpe



      Artista:

      Cara
      Kelly



      Artista de entornos:

      Finley Child'
    m_Metadata:
      m_Items: []
  - m_Id: 4474609280737280
    m_Localized: "Jefe t\xE9cnico:\r\nPeter Delap\r\n\r\n\r\nIngeniero jefe de UI
      y UX:\r\nJamie Holgate\r\n\r\nDise\xF1adora:\r\nDaisy Plumb"
    m_Metadata:
      m_Items: []
  - m_Id: 4474610903932928
    m_Localized: "M\xFAsica:\r\nM\xFAsica del men\xFA: \xABArriving At Shore\xBB
      (versi\xF3n en bucle) de flowerheadmusic.itch.io\r\n\r\nM\xFAsica del juego:
      \xABCursed Sea\xBB de alkakrab.itch.io\r\n\r\nEfectos de sonido:\r\nFilmCow
      Royalty Free Sound Effects Library de filmcow.itch.io"
    m_Metadata:
      m_Items: []
  - m_Id: 4474612694900736
    m_Localized: 'Desarrollado por ToasterCar



      Publicado por Port In The
      Storm'
    m_Metadata:
      m_Items: []
  - m_Id: 4474614334873600
    m_Localized: JUEGO TERMINADO
    m_Metadata:
      m_Items: []
  - m_Id: 4474616050343936
    m_Localized: "AL MEN\xDA"
    m_Metadata:
      m_Items: []
  - m_Id: 4474617698705408
    m_Localized: PAUSA
    m_Metadata:
      m_Items: []
  - m_Id: 4474619355455488
    m_Localized: REANUDAR
    m_Metadata:
      m_Items: []
  - m_Id: 4474620953485312
    m_Localized: AUDIO
    m_Metadata:
      m_Items: []
  - m_Id: 4474622408908800
    m_Localized: IDIOMA
    m_Metadata:
      m_Items: []
  - m_Id: 4473255514595328
    m_Localized: SALIR
    m_Metadata:
      m_Items: []
  - m_Id: 4473267258646528
    m_Localized: "Puntuaci\xF3n:"
    m_Metadata:
      m_Items: []
  - m_Id: 4473271251623936
    m_Localized: TUTORIAL
    m_Metadata:
      m_Items: []
  - m_Id: 4474597175975936
    m_Localized: Usa las teclas A y D para mover la nave hacia la izquierda y hacia
      la derecha.
    m_Metadata:
      m_Items: []
  - m_Id: 4474600040685568
    m_Localized: "Navega junto a un muelle para recoger y entregar carga autom\xE1ticamente
      y ganar puntos."
    m_Metadata:
      m_Items: []
  - m_Id: 4474602259472384
    m_Localized: "\xA1Si chocas contra las rocas y las islas, se te romper\xE1 la
      carga y perder\xE1s un coraz\xF3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 4474604260155392
    m_Localized: "La lluvia empapa los libros, la nieve da\xF1a a los animales y
      los rayos de sol hacen que se pudren los pl\xE1tanos."
    m_Metadata:
      m_Items: []
  - m_Id: 4474605963042816
    m_Localized: "\xA1Mucha suerte!"
    m_Metadata:
      m_Items: []
